@* Danh sách sản phẩm *@
<section class="section-four mt-5">
    <div class="container position-relative bg-white rounded-4 p-4 shadow-sm" data-reveal>
        <h3 class="fw-bold mb-4">Tự Teen Chinh Phục Hành Trình Mới</h3>

        @* Khung chứa danh sách sản phẩm *@
        <div class="product-scroll-wrapper d-flex gap-4 overflow-x-auto" id="productScrollContainer">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="card border-0 product-card flex-shrink-0">
                        <img src="@item.HinhAnh" class="card-img-top p-3 img-fluid object-fit-contain" alt="@item.TenSp">
                        <div class="card-body px-3 pb-4 pt-2">
                            <span class="badge border border-secondary text-secondary rounded-pill mb-2 px-2 py-1">
                                Trả góp 0%
                            </span>
                            <h5 class="text-danger fw-bold mb-1">@item.DonGia.ToString("N0")đ</h5>
                            <p class="card-text text-truncate mb-0">@item.TenSp</p>
                        </div>
                    </div>
                }
            }
        </div>

        @* Nút điều hướng tự viết *@
        <button class="section-four-nav btn-prev" type="button" onclick="scrollProducts(-300)">
            <i class="bi bi-chevron-left"></i>
        </button>
        <button class="section-four-nav btn-next" type="button" onclick="scrollProducts(300)">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
</section>

