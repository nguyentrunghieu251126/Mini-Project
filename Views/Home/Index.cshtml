@* Khu vực giới thiệu *@
<section class="section-one">
    <div class="container">
        <div class="row g-4 align-items-center">
            @* Thêm thuộc tính data-reveal để js *@
            <div class="col-lg-6 d-none d-lg-block" data-reveal>
                @* Dòng chữ nổi bật *@
                <span class="eyebrow"><i class="bi bi-stars"></i>Sống nhanh hơn cùng công nghệ tinh gọn</span>
                <h1 class="section-one-title">Không chỉ bán thiết bị, TDS thiết kế trọn trải nghiệm mua sắm công nghệ
                </h1>
                <p class="section-one-text">
                    Từ điện thoại, tablet tới workstation và phụ kiện thông minh, mọi sản phẩm đều được
                    tuyển chọn để cân bằng giữa hiệu năng, thẩm mỹ và độ bền sử dụng lâu dài
                </p>
                @* Sau này bổ xung thêm đường dẫn cho 2 button *@
                @* Các nút chức năng *@
                <div class="section-one-actions">
                    <a href="#"
                       class="text-decoration-none btn btn-accent btn-lg d-inline-flex justify-content-center align-items-center">
                        Khám phá ngay
                    </a>
                    <a href="#"
                       class="text-decoration-none btn btn-outline-dark btn-lg d-inline-flex justify-content-center align-items-center">
                        Xem ưu đãi
                    </a>
                </div>

                @* Thành phần bổ trợ *@
                <div class="row g-3 stats-grid">
                    <div class="col-sm-4">
                        <div class="stat-card">
                            <strong data-counter="1200">0</strong>
                            <span>đơn giao mỗi tuần</span>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="stat-card">
                            <strong data-counter="96">0</strong>
                            <span>khách quay lại mua</span>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="stat-card">
                            <strong data-counter="24">0</strong>
                            <span>giờ hỗ trợ liên tục</span>
                        </div>
                    </div>
                </div>
            </div>

            @* Ảnh miêu tả chính cho giao diện *@
            <div class="col-lg-6" data-reveal>
                <div class="section-one-visual">
                    <div class="section-one-visual-content section-one-visual-banner">
                        <img src="~/image/section-one.avif" class="d-block w-100"
                             alt="Điện thoại trưng bày trong showroom công nghệ" />
                        <div class="section-one-slide-content section-one-slide-content-safe">
                            <span>Premium pick</span>
                            <h2>Flagship mới cho người cần mọi thứ thật mượt</h2>
                        </div>
                    </div>

                    <div class="section-one-floating-card section-one-floating-card-dark">
                        <div class="section-one-floating-icon"><i class="bi bi-truck"></i></div>
                        <div>
                            <strong>Giao hỏa tốc</strong>
                            <p class="mb-0">Nội thành từ 2 giờ</p>
                        </div>
                    </div>

                    <div class="section-one-floating-card section-one-floating-card-light">
                        <div class="section-one-floating-icon"><i class="bi bi-shield-check"></i></div>
                        <div>
                            <strong>THT - Tech</strong>
                            <p class="mb-0">1 đổi 1 trong 30 ngày</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* Danh mục chi cập nhanh *@
<section class="section-two">
    <div class="container">
        <div class="category-shell" data-reveal>
            <a href="#" class="text-decoration-none category-pill">
                <span class="category-icon category-icon-blue"><i class="bi bi-phone"></i></span>
                <span>
                    <strong>Điện thoại</strong>
                    <small>Flagship, camera phone, gaming</small>
                </span>
            </a>
            <a href="#" class="text-decoration-none category-pill">
                <span class="category-icon category-icon-orange"><i class="bi bi-tablet"></i></span>
                <span>
                    <strong>Tablet</strong>
                    <small>Học tập, vẽ, ghi chú, giải trí</small>
                </span>
            </a>
            <a href="#" class="text-decoration-none category-pill">
                <span class="category-icon category-icon-dark"><i class="bi bi-laptop"></i></span>
                <span>
                    <strong>Laptop</strong>
                    <small>Ultrabook, sáng tạo nội dung, workstation</small>
                </span>
            </a>
            <a href="#" class="text-decoration-none category-pill">
                <span class="category-icon category-icon-green"><i class="bi bi-headphones"></i></span>
                <span>
                    <strong>Phụ kiện</strong>
                    <small>Sạc nhanh, tai nghe, hệ sinh thái gọn nhẹ</small>
                </span>
            </a>
        </div>
    </div>
</section>

@* Banner Carousel Section *@
<section class="section-three mt-5">
    <div class="container" data-reveal>
        @* Giao diện PC *@
        <div id="promoCarouselDesktop" class="carousel slide d-none d-md-block" data-bs-ride="carousel"
             data-bs-interval="4000">
            <div class="carousel-inner rounded-4">
                @* Slide 1 *@
                <div class="carousel-item active">
                    <div class="row g-3">
                        <div class="col-6">
                            <a href="#">
                                <img src="~/image/Carousel/anh1.webp" class="d-block w-100 section-three-img-custom"
                                     alt="Khuyến mãi 1">
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="#">
                                <img src="~/image/Carousel/anh2.webp" class="d-block w-100 section-three-img-custom"
                                     alt="Khuyến mãi 2">
                            </a>
                        </div>
                    </div>
                </div>

                @* Slide 2 *@
                <div class="carousel-item">
                    <div class="row g-3">
                        <div class="col-6">
                            <a href="#">
                                <img src="~/image/Carousel/anh3.webp" class="d-block w-100 section-three-img-custom"
                                     alt="Khuyến mãi 3">
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="#">
                                <img src="~/image/Carousel/anh4.webp" class="d-block w-100 section-three-img-custom"
                                     alt="Khuyến mãi 4">
                            </a>
                        </div>
                    </div>
                </div>

                @* Slide 3 *@
                <div class="carousel-item">
                    <div class="row g-3">
                        <div class="col-6">
                            <a href="#">
                                <img src="~/image/Carousel/anh5.webp" class="d-block w-100 section-three-img-custom"
                                     alt="Khuyến mãi 5">
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="#">
                                <img src="~/image/Carousel/anh6.webp" class="d-block w-100 section-three-img-custom"
                                     alt="Khuyến mãi 6">
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            @* Nút điều hướng *@
            <button class="carousel-control-prev section-three-navigation" type="button"
                    data-bs-target="#promoCarouselDesktop" data-bs-slide="prev">
                <span class="carousel-control-prev-icon section-three-navigation-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next section-three-navigation" type="button"
                    data-bs-target="#promoCarouselDesktop" data-bs-slide="next">
                <span class="carousel-control-next-icon section-three-navigation-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>

        @* Gieo diện mobile *@
        <div id="promoCarouselMobile" class="carousel slide d-block d-md-none" data-bs-ride="carousel"
             data-bs-interval="4000">
            <div class="carousel-inner rounded-4">
                @* Slide 1 *@
                <div class="carousel-item active">
                    <a href="#">
                        <img src="~/image/Carousel/anh1.webp" class="d-block w-100 section-three-img-custom"
                             alt="Khuyến mãi 1">
                    </a>
                </div>

                @* Slide 2 *@
                <div class="carousel-item">
                    <a href="#">
                        <img src="~/image/Carousel/anh2.webp" class="d-block w-100 section-three-img-custom"
                             alt="Khuyến mãi 2">
                    </a>
                </div>

                @* Slide 3 *@
                <div class="carousel-item">
                    <a href="#">
                        <img src="~/image/Carousel/anh3.webp" class="d-block w-100 section-three-img-custom"
                             alt="Khuyến mãi 3">
                    </a>
                </div>

                @* Slide 4 *@
                <div class="carousel-item">
                    <a href="#">
                        <img src="~/image/Carousel/anh4.webp" class="d-block w-100 section-three-img-custom"
                             alt="Khuyến mãi 4">
                    </a>
                </div>

                @* Slide 5 *@
                <div class="carousel-item">
                    <a href="#">
                        <img src="~/image/Carousel/anh5.webp" class="d-block w-100 section-three-img-custom"
                             alt="Khuyến mãi 5">
                    </a>
                </div>

                @* Slide 6 *@
                <div class="carousel-item">
                    <a href="#">
                        <img src="~/image/Carousel/anh6.webp" class="d-block w-100 section-three-img-custom"
                             alt="Khuyến mãi 6">
                    </a>
                </div>
            </div>

            @* Nút điều hướng *@
            <button class="carousel-control-prev section-three-navigation" type="button"
                    data-bs-target="#promoCarouselMobile" data-bs-slide="prev">
                <span class="carousel-control-prev-icon section-three-navigation-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next section-three-navigation" type="button"
                    data-bs-target="#promoCarouselMobile" data-bs-slide="next">
                <span class="carousel-control-next-icon section-three-navigation-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>
</section>